<Window x:Class="NeptunoApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NeptunoApp.Views"
        Title="Neptuno · Laboratorio ADO.NET" 
        Width="1280" Height="820" MinWidth="1020" MinHeight="680" 
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ContentBgBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource SidebarBgBrush}" Padding="20,28">
            <DockPanel>
                <!-- Brand Header -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,30">
                    <Border Width="44" Height="44" CornerRadius="10" Background="{StaticResource PrimaryBrush}" HorizontalAlignment="Left">
                        <TextBlock Text="N" Foreground="White" FontWeight="Bold" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="NEPTUNO" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,12,0,2"/>
                    <TextBlock Text="Sistema de Gestión" Foreground="#64748B" FontSize="11"/>
                </StackPanel>

                <!-- Navigation Section Title -->
                <TextBlock DockPanel.Dock="Top" Text="MÓDULOS PRINCIPALES" Foreground="#64748B" FontSize="10" FontWeight="Bold" Margin="4,0,0,12"/>

                <!-- Navigation Buttons -->
                <StackPanel DockPanel.Dock="Top">
                    <Button Style="{StaticResource NavButton}" Content="📦  Productos" Command="{Binding VerProductosCommand}" Margin="0,2"/>
                    <Button Style="{StaticResource NavButton}" Content="🏷️  Categorías" Command="{Binding VerCategoriasCommand}" Margin="0,2"/>
                    <Button Style="{StaticResource NavButton}" Content="🚚  Proveedores" Command="{Binding VerProveedoresCommand}" Margin="0,2"/>
                    <Button Style="{StaticResource NavButton}" Content="📋  Pedidos" Command="{Binding VerPedidosCommand}" Margin="0,2"/>
                    <Button Style="{StaticResource NavButton}" Content="📊  Reporte por Fechas" Command="{Binding VerReportesCommand}" Margin="0,2"/>
                </StackPanel>

                <Grid/>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <views:ProductosView DataContext="{Binding Productos}" Visibility="{Binding MostrarProductos, Converter={StaticResource BoolToVis}}"/>
            <views:CategoriasView DataContext="{Binding Categorias}" Visibility="{Binding MostrarCategorias, Converter={StaticResource BoolToVis}}"/>
            <views:ProveedoresView DataContext="{Binding Proveedores}" Visibility="{Binding MostrarProveedores, Converter={StaticResource BoolToVis}}"/>
            <views:PedidosView DataContext="{Binding Pedidos}" Visibility="{Binding MostrarPedidos, Converter={StaticResource BoolToVis}}"/>
            <views:ReportesView DataContext="{Binding Reportes}" Visibility="{Binding MostrarReportes, Converter={StaticResource BoolToVis}}"/>
        </Grid>
    </Grid>
</Window>
