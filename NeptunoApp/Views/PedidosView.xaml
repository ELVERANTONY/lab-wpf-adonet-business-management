<UserControl x:Class="NeptunoApp.Views.PedidosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="24,20">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Mantenimiento de Pedidos" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Gestión de cabeceras de órdenes, clientes, empleados y envíos" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
            <Button Style="{StaticResource PrimaryButton}" Content="🔄 Actualizar" Command="{Binding CargarCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,7"/>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Form Card -->
            <Border Grid.Column="0" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Datos del Pedido" FontSize="16" FontWeight="Bold" Margin="0,0,0,14"/>

                        <TextBlock Text="Cliente *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Clientes}" SelectedItem="{Binding Cliente}" DisplayMemberPath="Empresa" Margin="0,0,0,10"/>

                        <TextBlock Text="Empleado *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Empleados}" SelectedItem="{Binding Empleado}" DisplayMemberPath="NombreCompleto" Margin="0,0,0,10"/>

                        <TextBlock Text="Transportista" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Transportistas}" SelectedItem="{Binding Transportista}" DisplayMemberPath="CompaniaNombre" Margin="0,0,0,10"/>

                        <TextBlock Text="Fecha del Pedido *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding FechaPedido}" Margin="0,0,0,10"/>

                        <TextBlock Text="Fecha Requerida" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding FechaRequerida}" Margin="0,0,0,10"/>

                        <TextBlock Text="Fecha de Envío" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding FechaEnvio}" Margin="0,0,0,10"/>

                        <TextBlock Text="Destinatario" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Destinatario, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ciudad Destino" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding CiudadDestino, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="País Destino" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding PaisDestino, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding Mensaje}" Foreground="#0F766E" TextWrapping="Wrap" Margin="0,0,0,10" FontWeight="SemiBold"/>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Limpiar" Command="{Binding NuevoCommand}"/>
                            <Button Grid.Column="2" Style="{StaticResource OrangeButton}" Content="Guardar" Command="{Binding GuardarCommand}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Grid Card -->
            <Border Grid.Column="2" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ProgressBar Grid.Row="0" IsIndeterminate="True" Height="4" Margin="0,0,0,8" Visibility="{Binding EstaCargando, Converter={StaticResource BoolToVis}}"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Pedidos}" SelectedItem="{Binding Seleccionado}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="N° Pedido" Binding="{Binding PedidoID}" Width="70"/>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding FechaPedido, StringFormat='{}{0:dd/MM/yyyy}'}" Width="95"/>
                            <DataGridTextColumn Header="Cliente" Binding="{Binding NombreCliente}" Width="1.5*"/>
                            <DataGridTextColumn Header="Empleado" Binding="{Binding NombreEmpleado}" Width="1.2*"/>
                            <DataGridTextColumn Header="Ciudad Destino" Binding="{Binding CiudadDestino}" Width="*"/>
                            <DataGridTextColumn Header="Total (S/)" Binding="{Binding Total, StringFormat='S/ {0:N2}'}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="✏️ Editar" Command="{Binding EditarCommand}" CommandParameter="{Binding Seleccionado}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource DangerButton}" Content="🗑️ Eliminar" Command="{Binding EliminarCommand}" CommandParameter="{Binding Seleccionado}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
