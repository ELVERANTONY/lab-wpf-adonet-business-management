<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:NeptunoApp.ViewModels" x:Class="NeptunoApp.Views.CategoriasView" x:DataType="vm:CategoriasViewModel">
 <Grid RowDefinitions="Auto,*" Margin="28,22"><Grid ColumnDefinitions="*,Auto" Margin="0,0,0,18"><StackPanel><TextBlock Text="Mantenimiento de categorías" FontSize="26" FontWeight="Bold"/><TextBlock Text="Clasificación de los productos" Foreground="#64748B"/></StackPanel><Button Grid.Column="1" Classes="primary" Content="Actualizar" Command="{Binding CargarCommand}"/></Grid>
 <Grid Grid.Row="1" ColumnDefinitions="350,*" ColumnSpacing="18"><Border Background="White" CornerRadius="14" Padding="22"><StackPanel Spacing="10"><TextBlock Text="Datos de categoría" FontSize="18" FontWeight="Bold"/><TextBlock Text="Nombre *"/><TextBox Text="{Binding Nombre}" MaxLength="30"/><TextBlock Text="Descripción"/><TextBox Text="{Binding Descripcion}" MaxLength="200" AcceptsReturn="True" Height="100" TextWrapping="Wrap"/><TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" Foreground="#0F766E"/><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Content="Nuevo / Cancelar" Command="{Binding NuevoCommand}"/><Button Grid.Column="1" Classes="orange" Content="Guardar" Command="{Binding GuardarCommand}"/></Grid></StackPanel></Border>
 <Border Grid.Column="1" Background="White" CornerRadius="14" Padding="16"><Grid RowDefinitions="Auto,*"><ProgressBar IsIndeterminate="True" IsVisible="{Binding EstaCargando}"/><DataGrid Grid.Row="1" ItemsSource="{Binding Categorias}" SelectedItem="{Binding Seleccionada}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding CategoriaID}" Width="65"/><DataGridTextColumn Header="Categoría" Binding="{Binding NombreCategoria}" Width="*"/><DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="2*"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Spacing="8" Margin="8"><Button Classes="primary" Content="Editar" Command="{Binding EditarCommand}" CommandParameter="{Binding Seleccionada}"/><Button Classes="danger" Content="Eliminar" Command="{Binding EliminarCommand}" CommandParameter="{Binding Seleccionada}"/></StackPanel></Grid></Border></Grid></Grid>
</UserControl>
