<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:NeptunoApp.ViewModels" x:Class="NeptunoApp.Views.ReportesView" x:DataType="vm:ReportesViewModel">
 <Grid RowDefinitions="Auto,Auto,*" Margin="20,22">
  <StackPanel><TextBlock Text="Reporte de detalles de pedidos" FontSize="26" FontWeight="Bold"/><TextBlock Text="Consulta mediante INNER JOIN y rango de fechas" Foreground="#64748B"/></StackPanel>
  <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16" Margin="0,16">
   <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*,Auto" ColumnSpacing="16" RowSpacing="10">
    <StackPanel Spacing="5"><TextBlock Text="Fecha inicial" Foreground="#475569" FontWeight="SemiBold"/><DatePicker SelectedDate="{Binding FechaInicio}" HorizontalAlignment="Stretch" DayFormat="dd" MonthFormat="MMMM" YearFormat="yyyy"/></StackPanel>
    <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="Fecha final" Foreground="#475569" FontWeight="SemiBold"/><DatePicker SelectedDate="{Binding FechaFin}" HorizontalAlignment="Stretch" DayFormat="dd" MonthFormat="MMMM" YearFormat="yyyy"/></StackPanel>
    <Button Grid.Column="2" Classes="orange" Content="Consultar" Command="{Binding ConsultarCommand}" VerticalAlignment="Bottom" MinWidth="120"/>
    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Mensaje}" Foreground="#0F766E" TextWrapping="Wrap"/>
   </Grid>
  </Border>
  <Border Grid.Row="2" Background="White" CornerRadius="14" Padding="14"><Grid RowDefinitions="Auto,*,Auto">
   <ProgressBar IsVisible="{Binding EstaCargando}" IsIndeterminate="True"/>
   <DataGrid Grid.Row="1" ItemsSource="{Binding Lineas}" AutoGenerateColumns="False" IsReadOnly="True" FontSize="12" CanUserSortColumns="True" CanUserReorderColumns="False" HorizontalScrollBarVisibility="Auto">
    <DataGrid.Columns>
     <DataGridTextColumn Header="Pedido" Binding="{Binding PedidoID}" Width="72"/>
     <DataGridTextColumn Header="Fecha" Binding="{Binding FechaPedido, StringFormat='{}{0:dd/MM/yyyy}'}" Width="110"/>
     <DataGridTextColumn Header="Cliente" Binding="{Binding NombreCliente}" Width="1.35*" MinWidth="180"/>
     <DataGridTextColumn Header="Producto" Binding="{Binding NombreProducto}" Width="1.25*" MinWidth="170"/>
     <DataGridTextColumn Header="Precio" Binding="{Binding PrecioUnidad, StringFormat='S/ {0:N2}'}" Width="88"/>
     <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="82"/>
     <DataGridTextColumn Header="Descuento" Binding="{Binding Descuento, StringFormat='{}{0:P0}'}" Width="100"/>
     <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat='S/ {0:N2}'}" Width="100"/>
    </DataGrid.Columns>
   </DataGrid>
   <TextBlock Grid.Row="2" Text="{Binding Total, StringFormat='Total general: S/ {0:N2}'}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,12,8,0"/>
  </Grid></Border>
 </Grid>
</UserControl>
