<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:NeptunoApp.ViewModels" xmlns:m="using:NeptunoApp.Models" x:Class="NeptunoApp.Views.ProductosView" x:DataType="vm:ProductosViewModel">
 <Grid RowDefinitions="Auto,*" Margin="20,22">
  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,18"><StackPanel><TextBlock Text="Mantenimiento de productos" FontSize="26" FontWeight="Bold"/><TextBlock Text="Catálogo, precios e inventario" Foreground="#64748B"/></StackPanel><Button Grid.Column="1" Classes="primary" Content="Actualizar" Command="{Binding CargarCommand}"/></Grid>
  <Grid Grid.Row="1" ColumnDefinitions="315,*" ColumnSpacing="16">
   <Border Background="White" CornerRadius="14" Padding="20"><ScrollViewer><StackPanel Spacing="8">
    <TextBlock Text="Datos del producto" FontSize="18" FontWeight="Bold"/><TextBlock Text="Nombre *"/><TextBox Text="{Binding NombreProducto}" MaxLength="60" PlaceholderText="Ej. Café Andino"/>
    <TextBlock Text="Categoría *"/><ComboBox ItemsSource="{Binding Categorias}" SelectedItem="{Binding CategoriaSeleccionada}" HorizontalAlignment="Stretch" MinWidth="280"><ComboBox.ItemTemplate><DataTemplate x:DataType="m:Categoria"><TextBlock Text="{Binding NombreCategoria}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
    <TextBlock Text="Proveedor *"/><ComboBox ItemsSource="{Binding Proveedores}" SelectedItem="{Binding ProveedorSeleccionado}" HorizontalAlignment="Stretch" MinWidth="280"><ComboBox.ItemTemplate><DataTemplate x:DataType="m:Proveedor"><TextBlock Text="{Binding CompaniaNombre}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
    <TextBlock Text="Cantidad por unidad"/><TextBox Text="{Binding CantidadPorUnidad}" PlaceholderText="Ej. 500 g"/>
    <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><StackPanel><TextBlock Text="Precio S/"/><NumericUpDown Value="{Binding PrecioUnidad}" Minimum="0" FormatString="0.00"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Existencia"/><NumericUpDown Value="{Binding UnidadesEnExistencia}" Minimum="0" Maximum="32767"/></StackPanel></Grid>
    <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><StackPanel><TextBlock Text="En pedido"/><NumericUpDown Value="{Binding UnidadesEnPedido}" Minimum="0" Maximum="32767"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Reorden"/><NumericUpDown Value="{Binding NivelDeReorden}" Minimum="0" Maximum="32767"/></StackPanel></Grid>
    <CheckBox Content="Descontinuado" IsChecked="{Binding Descontinuado}"/><TextBlock Text="{Binding MensajeError}" Foreground="#DC2626" TextWrapping="Wrap"/><TextBlock Text="{Binding MensajeExito}" Foreground="#0F766E"/>
    <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Content="Nuevo / Cancelar" Command="{Binding NuevoCommand}"/><Button Grid.Column="1" Classes="orange" Content="Guardar" Command="{Binding GuardarCommand}"/></Grid>
   </StackPanel></ScrollViewer></Border>
   <Border Grid.Column="1" Background="White" CornerRadius="14" Padding="14"><Grid RowDefinitions="Auto,*"><ProgressBar IsIndeterminate="True" IsVisible="{Binding EstaCargando}"/><DataGrid Grid.Row="1" ItemsSource="{Binding Productos}" SelectedItem="{Binding ProductoSeleccionado}" AutoGenerateColumns="False" IsReadOnly="True" FontSize="12" HorizontalScrollBarVisibility="Auto" CanUserSortColumns="True" CanUserReorderColumns="False"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding ProductoID}" Width="44"/><DataGridTextColumn Header="Producto" Binding="{Binding NombreProducto}" Width="1.6*" MinWidth="160"/><DataGridTextColumn Header="Categoría" Binding="{Binding NombreCategoria}" Width="1.05*" MinWidth="105"/><DataGridTextColumn Header="Proveedor" Binding="{Binding NombreProveedor}" Width="1.55*" MinWidth="175"/><DataGridTextColumn Header="Precio" Binding="{Binding PrecioUnidad, StringFormat='S/ {0:N2}'}" Width="82"/><DataGridTextColumn Header="Stock" Binding="{Binding UnidadesEnExistencia}" Width="58"/></DataGrid.Columns></DataGrid>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Spacing="8" Margin="8"><Button Classes="primary" Content="Editar" Command="{Binding EditarCommand}" CommandParameter="{Binding ProductoSeleccionado}"/><Button Classes="danger" Content="Eliminar" Command="{Binding EliminarCommand}" CommandParameter="{Binding ProductoSeleccionado}"/></StackPanel>
   </Grid></Border>
  </Grid>
 </Grid>
</UserControl>
