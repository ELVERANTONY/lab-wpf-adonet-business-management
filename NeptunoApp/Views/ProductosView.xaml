<UserControl x:Class="NeptunoApp.Views.ProductosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:NeptunoApp.Models"
             Margin="24,20">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Mantenimiento de Productos" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Gestión completa de catálogo, precios y stock" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
            <Button Style="{StaticResource PrimaryButton}" Content="🔄 Actualizar" Command="{Binding CargarCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,7"/>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Form Card -->
            <Border Grid.Column="0" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Datos del Producto" FontSize="16" FontWeight="Bold" Margin="0,0,0,14"/>

                        <TextBlock Text="Nombre del Producto *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NombreProducto, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" Margin="0,0,0,10"/>

                        <TextBlock Text="Categoría *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Categorias}" SelectedItem="{Binding CategoriaSeleccionada}" DisplayMemberPath="NombreCategoria" Margin="0,0,0,10"/>

                        <TextBlock Text="Proveedor *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Proveedores}" SelectedItem="{Binding ProveedorSeleccionado}" DisplayMemberPath="CompaniaNombre" Margin="0,0,0,10"/>

                        <TextBlock Text="Cantidad por Unidad" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding CantidadPorUnidad, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Precio (S/) *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding PrecioUnidad, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Existencia *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding UnidadesEnExistencia, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="En Pedido" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding UnidadesEnPedido, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Nivel Reorden" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding NivelDeReorden, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="Descontinuado" IsChecked="{Binding Descontinuado}" Margin="0,4,0,10"/>

                        <TextBlock Text="{Binding MensajeError}" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding MensajeExito}" Foreground="#0F766E" TextWrapping="Wrap" Margin="0,0,0,8" FontWeight="SemiBold"/>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Limpiar" Command="{Binding NuevoCommand}"/>
                            <Button Grid.Column="2" Style="{StaticResource OrangeButton}" Content="Guardar" Command="{Binding GuardarCommand}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Grid Card -->
            <Border Grid.Column="2" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ProgressBar Grid.Row="0" IsIndeterminate="True" Height="4" Margin="0,0,0,8" Visibility="{Binding EstaCargando, Converter={StaticResource BoolToVis}}"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Productos}" SelectedItem="{Binding ProductoSeleccionado}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ProductoID}" Width="50"/>
                            <DataGridTextColumn Header="Producto" Binding="{Binding NombreProducto}" Width="2*"/>
                            <DataGridTextColumn Header="Categoría" Binding="{Binding NombreCategoria}" Width="1.2*"/>
                            <DataGridTextColumn Header="Proveedor" Binding="{Binding NombreProveedor}" Width="1.5*"/>
                            <DataGridTextColumn Header="Precio (S/)" Binding="{Binding PrecioUnidad, StringFormat='S/ {0:N2}'}" Width="90"/>
                            <DataGridTextColumn Header="Stock" Binding="{Binding UnidadesEnExistencia}" Width="65"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="✏️ Editar" Command="{Binding EditarCommand}" CommandParameter="{Binding ProductoSeleccionado}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource DangerButton}" Content="🗑️ Eliminar" Command="{Binding EliminarCommand}" CommandParameter="{Binding ProductoSeleccionado}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
