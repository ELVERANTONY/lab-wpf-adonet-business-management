<UserControl x:Class="NeptunoApp.Views.ProveedoresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="24,20">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Mantenimiento de Proveedores" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Gestión de proveedores con búsqueda combinada por contacto y ciudad" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Search Bar Filter Card -->
        <Border Grid.Row="1" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Text="{Binding FiltroContacto, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" ToolTip="Filtrar por Nombre de Contacto"/>
                <TextBox Grid.Column="2" Text="{Binding FiltroCiudad, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" ToolTip="Filtrar por Ciudad"/>
                <Button Grid.Column="4" Style="{StaticResource PrimaryButton}" Content="🔍 Buscar" Command="{Binding BuscarCommand}"/>
                <Button Grid.Column="6" Content="🧹 Limpiar" Command="{Binding LimpiarBusquedaCommand}"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Form Card -->
            <Border Grid.Column="0" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Datos del Proveedor" FontSize="16" FontWeight="Bold" Margin="0,0,0,14"/>

                        <TextBlock Text="Compañía / Empresa *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Compania, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Contacto" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Contacto, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Cargo" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Cargo, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Dirección" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Direccion, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ciudad" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Ciudad, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Código Postal" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding CodigoPostal, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="País" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Pais, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Teléfono" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Fax" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Fax, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                        <TextBlock Text="{Binding Mensaje}" Foreground="#0F766E" TextWrapping="Wrap" Margin="0,0,0,10" FontWeight="SemiBold"/>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Limpiar" Command="{Binding NuevoCommand}"/>
                            <Button Grid.Column="2" Style="{StaticResource OrangeButton}" Content="Guardar" Command="{Binding GuardarCommand}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Grid Card -->
            <Border Grid.Column="2" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ProgressBar Grid.Row="0" IsIndeterminate="True" Height="4" Margin="0,0,0,8" Visibility="{Binding EstaCargando, Converter={StaticResource BoolToVis}}"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Proveedores}" SelectedItem="{Binding Seleccionado}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ProveedorID}" Width="45"/>
                            <DataGridTextColumn Header="Compañía" Binding="{Binding CompaniaNombre}" Width="1.8*"/>
                            <DataGridTextColumn Header="Contacto" Binding="{Binding NombreContacto}" Width="1.2*"/>
                            <DataGridTextColumn Header="Ciudad" Binding="{Binding Ciudad}" Width="*"/>
                            <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="✏️ Editar" Command="{Binding EditarCommand}" CommandParameter="{Binding Seleccionado}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource DangerButton}" Content="🗑️ Eliminar" Command="{Binding EliminarCommand}" CommandParameter="{Binding Seleccionado}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
