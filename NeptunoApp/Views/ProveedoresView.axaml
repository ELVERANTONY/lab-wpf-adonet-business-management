<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:NeptunoApp.ViewModels" x:Class="NeptunoApp.Views.ProveedoresView" x:DataType="vm:ProveedoresViewModel">
 <Grid RowDefinitions="Auto,Auto,*" Margin="20,22">
  <TextBlock Text="Mantenimiento y búsqueda de proveedores" FontSize="26" FontWeight="Bold"/>
  <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="14" Margin="0,14"><Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="10"><TextBox PlaceholderText="Nombre de contacto" Text="{Binding FiltroContacto}"/><TextBox Grid.Column="1" PlaceholderText="Ciudad" Text="{Binding FiltroCiudad}"/><Button Grid.Column="2" Classes="primary" Content="Buscar" Command="{Binding BuscarCommand}"/><Button Grid.Column="3" Content="Limpiar" Command="{Binding LimpiarBusquedaCommand}"/></Grid></Border>
  <Grid Grid.Row="2" ColumnDefinitions="325,*" ColumnSpacing="16">
   <Border Background="White" CornerRadius="14" Padding="18"><ScrollViewer><StackPanel Spacing="7"><TextBlock Text="Datos del proveedor" FontSize="18" FontWeight="Bold"/><TextBlock Text="Compañía *"/><TextBox Text="{Binding Compania}" MaxLength="60"/><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><StackPanel><TextBlock Text="Contacto"/><TextBox Text="{Binding Contacto}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Cargo"/><TextBox Text="{Binding Cargo}"/></StackPanel></Grid><TextBlock Text="Dirección"/><TextBox Text="{Binding Direccion}"/><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><StackPanel><TextBlock Text="Ciudad"/><TextBox Text="{Binding Ciudad}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Código postal"/><TextBox Text="{Binding CodigoPostal}"/></StackPanel></Grid><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><StackPanel><TextBlock Text="País"/><TextBox Text="{Binding Pais}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Teléfono"/><TextBox Text="{Binding Telefono}"/></StackPanel></Grid><TextBlock Text="Fax"/><TextBox Text="{Binding Fax}"/><TextBlock Text="{Binding Mensaje}" Foreground="#0F766E" TextWrapping="Wrap"/><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Content="Nuevo / Cancelar" Command="{Binding NuevoCommand}"/><Button Grid.Column="1" Classes="orange" Content="Guardar" Command="{Binding GuardarCommand}"/></Grid></StackPanel></ScrollViewer></Border>
   <Border Grid.Column="1" Background="White" CornerRadius="14" Padding="14"><Grid RowDefinitions="Auto,*"><ProgressBar IsVisible="{Binding EstaCargando}" IsIndeterminate="True"/><DataGrid Grid.Row="1" ItemsSource="{Binding Proveedores}" SelectedItem="{Binding Seleccionado}" AutoGenerateColumns="False" IsReadOnly="True" FontSize="12" CanUserSortColumns="True" CanUserReorderColumns="False" HorizontalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding ProveedorID}" Width="44"/><DataGridTextColumn Header="Compañía" Binding="{Binding CompaniaNombre}" Width="1.6*" MinWidth="190"/><DataGridTextColumn Header="Contacto" Binding="{Binding NombreContacto}" Width="1.15*" MinWidth="145"/><DataGridTextColumn Header="Ciudad" Binding="{Binding Ciudad}" Width="0.7*" MinWidth="95"/><DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="0.9*" MinWidth="115"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Spacing="8" Margin="8"><Button Classes="primary" Content="Editar" Command="{Binding EditarCommand}" CommandParameter="{Binding Seleccionado}"/><Button Classes="danger" Content="Eliminar" Command="{Binding EliminarCommand}" CommandParameter="{Binding Seleccionado}"/></StackPanel></Grid></Border>
  </Grid>
 </Grid>
</UserControl>
